---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const indexable = posts
    .filter(p => !p.data.noindex)
    .sort((a, b) => new Date(a.data.date) - new Date(b.data.date));

  return posts.map(post => {
    const i = indexable.findIndex(p => p.slug === post.slug);
    const prevPost = i > 0 ? indexable[i - 1] : null;
    const nextPost = i >= 0 && i < indexable.length - 1 ? indexable[i + 1] : null;
    return {
      params: { slug: post.slug },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  keywords={post.data.keywords}
  mainSite={post.data.mainSite || 'https://smarttv.one'}
  slug={post.slug}
  image={post.data.image}
  faq={post.data.faq}
  noindex={post.data.noindex}
  lean={post.data.lean}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPost>
